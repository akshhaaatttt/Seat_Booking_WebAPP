# Server
PORT=4000
NODE_ENV=development

# Absolute or relative path to the SQLite database file
DATABASE_PATH=./data/seatbooking.db

# Secret used to sign JWT session tokens. MUST be overridden in production.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# Origin allowed to call the API with credentials (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Seat hold lifetime, in seconds (default 5 minutes)
HOLD_DURATION_SECONDS=300

# How often the background scheduler sweeps for expired holds, in seconds
HOLD_SWEEP_INTERVAL_SECONDS=30

# Bookings can no longer be cancelled within this many minutes of showtime
CANCELLATION_CUTOFF_MINUTES=60

# Maximum seats a single user may hold at once, per show
MAX_SEATS_PER_HOLD=8
